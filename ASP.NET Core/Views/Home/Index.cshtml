@using ASP_NET_Core.Models

@{
    var value = new object[] {
        new object[] { "Product_Current_Inventory", FilterBuilderFieldFilterOperations.NotEqual, 0 },
        "or",
        new object[] {
            new object[] { "Product_Name", FilterBuilderFieldFilterOperations.Contains, "HD" },
            "and",
            new object[] { "Product_Cost", FilterBuilderFieldFilterOperations.LessThan, 200 }
        }
    };
}

<div class="filter-container">
    @(Html.DevExtreme().FilterBuilder()
        .ID("filterBuilder")
        .Fields(fields => {
            fields.Add()
                .DataField("Product_ID")
                .Caption("ID")
                .DataType(FilterBuilderFieldDataType.Number);

            fields.Add()
                .DataField("Product_Name");

            fields.Add()
                .Caption("Cost")
                .DataField("Product_Cost")
                .DataType(FilterBuilderFieldDataType.Number)
                .Format(Format.Currency);

            fields.Add()
                .DataField("Product_Sale_Price")
                .Caption("Sale Price")
                .DataType(FilterBuilderFieldDataType.Number)
                .Format(Format.Currency);

            fields.Add()
                .DataField("Product_Retail_Price")
                .Caption("Retail Price")
                .DataType(FilterBuilderFieldDataType.Number)
                .Format(Format.Currency);

           fields.Add()
                .DataField("Product_Current_Inventory")
                .Caption("Inventory")
                .DataType(FilterBuilderFieldDataType.Number);

            fields.Add()
                .DataField("Product_Category")
                .Caption("Category")
                .DataType(FilterBuilderFieldDataType.String);

            fields.Add()
                .DataField("Product_Brand")
                .Caption("Brand")
                .DataType(FilterBuilderFieldDataType.String);

            fields.Add()
                .DataField("Product_SKU")
                .Caption("SKU")
                .DataType(FilterBuilderFieldDataType.String);

            fields.Add()
                .DataField("Product_Supplier")
                .Caption("Supplier")
                .DataType(FilterBuilderFieldDataType.String);

            fields.Add()
                .DataField("Product_Weight")
                .Caption("Weight (kg)")
                .DataType(FilterBuilderFieldDataType.Number);

            fields.Add()
                .DataField("Product_Created_Date")
                .Caption("Created Date")
                .DataType(FilterBuilderFieldDataType.Date);

            fields.Add()
                .DataField("Product_Last_Updated")
                .Caption("Last Updated")
                .DataType(FilterBuilderFieldDataType.DateTime);
        })
        .Value(value)
    )
</div>

<script>
    DevExpress.ui.dxTreeView.defaultOptions({
        device: { deviceType: 'desktop' },
        options: {
            onInitialized: (e) => {
                const treeViewInstance = e.component;
                if (treeViewInstance?.option('cssClass')?.includes('dx-filterbuilder-fields')) {
                    treeViewInstance?.option({
                        height: 200,
                        width: 200,
                        searchEnabled: true
                    });
                }
            }
        }
    });
</script>
